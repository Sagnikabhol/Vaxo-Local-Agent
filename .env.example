# ──────────────────────────────────────
# Vaxo — Environment Configuration
# Copy this file to .env and adjust values
# ──────────────────────────────────────

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
OLLAMA_TIMEOUT=60

# Conversation Settings
MAX_CONVERSATION_HISTORY=20

# Text-to-Speech Settings
TTS_ENABLED=true
TTS_RATE=175
TTS_VOLUME=0.9

# Speech-to-Text Settings
STT_ENABLED=true

# Database
DB_PATH=data/vaxo_history.db

# Debug & Demo Mode
DEBUG=false
DEMO_MODE=false
